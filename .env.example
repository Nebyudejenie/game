# Copy to .env and fill in real values. Never commit .env.
# Phase 0 (this pass) only needs DATABASE_URL / REDIS_URL to run migrations and tests.
# The rest are documented now so config.py has a stable shape; they are consumed
# starting Phase 1 (bot) and Phase 5-6 (payments).

# --- Database ---
# Port 5433, not 5432 -- deploy/docker-compose.yml maps Postgres there to
# avoid clashing with any other Postgres already running on this host.
DATABASE_URL=postgresql://jobingo:jobingo@localhost:5433/jobingo
# Sync driver URL used only by Alembic migrations (asyncpg has no sync mode).
DATABASE_URL_SYNC=postgresql+psycopg2://jobingo:jobingo@localhost:5433/jobingo

# --- Redis ---
# Port 6380, not 6379 -- same reason as Postgres above.
REDIS_URL=redis://localhost:6380/0

# --- Telegram (Phase 1) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Empty until the Mini App (Phase 4) is deployed -- see keyboards.py.
MINIAPP_URL=

# --- Payment providers (Phase 5-6) ---
CHAPA_API_KEY=
SANTIMPAY_API_KEY=
ARIFPAY_API_KEY=
# The bot process's own externally-reachable base URL -- only used to
# build the Telegram webhook URL bot.py registers with Telegram.
PUBLIC_BASE_URL=
# The payments service's own externally-reachable base URL -- Chapa's
# real server-to-server webhook (POST /webhooks/chapa) must land here, a
# different service than PUBLIC_BASE_URL above (see deploy/
# .env.prod.example's own comment on this split, and DECISIONS.md). Empty
# means /deposit honestly reports "not available yet" instead of handing
# Chapa a URL pointing nowhere.
PAYMENTS_PUBLIC_BASE_URL=
# The Payment Agent Portal's own externally-reachable base URL -- the
# bot's /portal command needs this to build the one-time login link it
# sends an agent. Empty means /portal honestly reports "not available
# yet" instead of sending a link pointing nowhere.
AGENT_PORTAL_BASE_URL=
MIN_DEPOSIT_ETB=10.00
DAILY_DEPOSIT_CAP_ETB=50000.00
MIN_WITHDRAW_ETB=50.00
AUTO_APPROVE_WITHDRAW_ETB=2000.00
KYC_REQUIRED_ABOVE_ETB=5000.00
WITHDRAW_CHARGEBACK_WINDOW_MINUTES=30

# --- Admin console (Phase 7) ---
# Comma-separated IPs; empty means unrestricted (dev-friendly default).
ADMIN_IP_ALLOWLIST=

# --- Phone number encryption at rest (spec section 9.2) ---
# 64 hex chars (32 bytes). No safe empty default -- registration can't
# work without it, in any environment. A real value used to sit here
# directly (removed 2026-09-05 -- it had leaked into git history as a
# real, working key, confirmed by hash comparison to differ from what
# production actually uses, but was live at HEAD for anyone cloning this
# repo to see). Generate your own, never reuse another environment's:
# python -c "import secrets; print(secrets.token_hex(32))"
PHONE_ENCRYPTION_KEY=

# --- Telebirr SMS-evidence deposits ---
# Bearer token the MacroDroid device must present to POST /internal/
# telebirr/ingest (services/payments/app.py). Empty means that route
# always rejects -- there is no safe default that would let an
# unauthenticated caller inject fabricated payment evidence. Generate one
# with:
# python -c "import secrets; print(secrets.token_hex(32))"
MACRODROID_INGEST_TOKEN=

# --- Observability ---
# Empty means reconcile_job.py only logs its result (a real scheduler
# already alerts on the process's own non-zero exit code). Set to also push
# the mismatch count to a real Prometheus Pushgateway -- e.g.
# http://localhost:9092 if you brought one up with
# `docker compose -f deploy/docker-compose.yml up -d pushgateway`.
PUSHGATEWAY_URL=
# Empty means every trace span (packages/core/tracing.py) is still safe to
# create, just discarded rather than exported anywhere. Set to a base OTLP
# URL -- e.g. http://localhost:4318 if you brought up Jaeger with
# `docker compose -f deploy/docker-compose.yml up -d jaeger` -- to actually
# see deposit/payout traces at http://localhost:16686.
OTEL_EXPORTER_ENDPOINT=

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
