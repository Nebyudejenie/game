# SUPERSEDED -- this file describes a direct cloudflared-in-Docker
# architecture (one hostname per Compose service name, `pay.arada.fun`
# not `payments.arada.fun`) that docs/PRODUCTION_DOMAIN_AND_CLOUDFLARE.md
# explicitly confirmed, after checking the live production host on
# 2026-09-05, "was never actually implemented." Production instead runs
# cloudflared as a host-level systemd service
# (/etc/systemd/system/cloudflared.service,
# /etc/cloudflared/config.yml -- NOT this repo's deploy/docker-compose.
# prod.yml `cloudflared` service, which is also stale for the same
# reason and should not be assumed to be what's actually running) that
# forwards to a Traefik instance on the same host (part of a separate,
# shared "hermis" stack, not tracked in this repository at all), which
# does the real per-hostname routing to gateway/admin/payments/bot by
# Host() rule. The real, verified hostnames are `payments.arada.fun`,
# `agent.arada.fun`, `admin.arada.fun`, `finance.arada.fun` (all real
# subdomains, not `pay.`/`bot.`/`sms.` as below) -- see that doc for the
# full real architecture diagram, and DECISIONS.md's 2026-09-14 entry for
# a real outage where all four of those routers were found to have
# silently disappeared from the (untracked, host-only) Traefik config
# with zero trace in version control to recover from, which is the
# entire reason this warning exists: don't debug from this file, and
# don't assume restoring it fixes anything in production.
#
# Kept in the repo only in case a *future*, genuinely containerized
# cloudflared deployment is deliberately adopted -- if so, update the
# hostnames below to match the real scheme first (this file's own
# `pay.arada.fun`/`bot.arada.fun`/`sms.arada.fun` do not match what's
# actually live). Copy to deploy/cloudflared/config.yml and fill in the
# real tunnel id -- never committed (see .gitignore). README.md's "Domain
# and Cloudflare Tunnel" section has the one-time setup this file is the
# last step of: installing cloudflared, `cloudflared tunnel login`,
# `cloudflared tunnel create jobingo` (prints the tunnel id and writes
# the credentials JSON this file's credentials-file line points at), and
# `cloudflared tunnel route dns jobingo <hostname>` once per subdomain
# below (creates the real DNS records -- nothing to click together in
# the Cloudflare dashboard).
#
# Ingress rules are evaluated top to bottom; the first matching hostname
# wins, and the final catch-all is required by cloudflared itself, matched
# only when no hostname above it matched. Every service: value is a plain
# Docker Compose service name -- reachable by that name only from inside
# this stack's own network, exactly how gateway/admin/payments/bot already
# reach postgres/redis today.

tunnel: <TUNNEL_ID>
credentials-file: /etc/cloudflared/tunnel-credentials.json

ingress:
  # Mini App static files, player REST API, and the game WebSocket.
  - hostname: app.arada.fun
    service: http://gateway:8000
  # Admin console -- IP-allowlisted at the application layer
  # (ADMIN_IP_ALLOWLIST) regardless of this subdomain being public;
  # the allowlist is the real boundary, not the hostname.
  - hostname: admin.arada.fun
    service: http://admin:8001
  # Chapa's real server-to-server webhook (POST /webhooks/chapa) --
  # PAYMENTS_PUBLIC_BASE_URL must match this exact hostname.
  - hostname: pay.arada.fun
    service: http://payments:8002
  # Telegram's webhook (POST /webhook) -- PUBLIC_BASE_URL must match
  # this exact hostname.
  - hostname: bot.arada.fun
    service: http://bot:8003
  # Enterprise SMS Control Plane -- a separate product/console, its own
  # admin login page at /console (same admin_users accounts as
  # admin.arada.fun; see DECISIONS.md 2026-09-07).
  - hostname: sms.arada.fun
    service: http://sms:8006
  - service: http_status:404
